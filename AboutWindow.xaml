<Window x:Class="WinMusicXmlPlayer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="關於 — Windows MusicXML 真實音源播放器"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="540" Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 頂部標題與圖示 -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="16,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="46" Height="46"
                        CornerRadius="10"
                        Background="{DynamicResource AccentSoftBgBrush}"
                        BorderBrush="{DynamicResource AccentPrimaryBrush}"
                        BorderThickness="1.5"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                    <TextBlock Text="🎼"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Windows MusicXML 真實音源播放器"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Version 1.2.0 · 繁體中文專業版 (WinMusicXmlPlayer)"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBlueBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 內容區塊：簡短說明、播放引擎、音源庫 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 簡短說明 -->
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="14,11"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📌 應用程式簡短說明"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlueBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="專為 MusicXML (.musicxml / .xml / .mxl) 樂譜設計的互動式視覺化與真實樂器取樣播放軟體。支援多聲部自動分離、反覆記號展開、各聲部獨立靜音/獨奏/音量與音色切換，並結合水平時間軸、垂直瀑布流卷軸與 88 鍵動態鋼琴模擬鍵盤。"
                                   FontSize="12.5"
                                   LineHeight="19"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2. 播放引擎 -->
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="14,11"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚙️ 播放引擎 (Playback Engine)"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlueBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="• 合成器核心：MeltySynth — 高精度 SoundFont 2 即時波表合成引擎（支援 128 複音、立體聲 Pan 定位、Reverb 空間殘響與 Chorus 合唱效果）"
                                   FontSize="12.5"
                                   LineHeight="18"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="• 音訊輸出層：NAudio — 採用 Windows WASAPI 低延遲共享模式與 WaveOut 44.1 kHz / 32-bit IEEE Float 雙聲道即時串流引擎"
                                   FontSize="12.5"
                                   LineHeight="18"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. 音源庫 -->
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="14,11">
                    <StackPanel>
                        <TextBlock Text="🔊 音源庫 (SoundFont Library)"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlueBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="• 內建標準音源庫：TimGM6mb.sf2（General MIDI 標準 128 種真實樂器取樣音色庫，自動依據聲部配器智慧指派鋼琴、弦樂四重奏、木管與銅管音色）"
                                   FontSize="12.5"
                                   LineHeight="18"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtCurrentSoundFontInfo"
                                   Text="• 目前載入音源：TimGM6mb.sf2"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部關閉按鈕 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="確定"
                    Style="{StaticResource PlayButtonStyle}"
                    Width="96"
                    Padding="12,6"
                    FontSize="13"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
