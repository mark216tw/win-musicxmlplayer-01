<Application x:Class="WinMusicXmlPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="BadgeCornerRadius">5</CornerRadius>

            <SolidColorBrush x:Key="BgPrimaryBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="BgSecondaryBrush" Color="#1E293B"/>
            <SolidColorBrush x:Key="BgSidebarBrush" Color="#151F32"/>
            <SolidColorBrush x:Key="BgCardBrush" Color="#1E293B"/>
            <SolidColorBrush x:Key="BgBadgeBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="BgMenuBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="BgPopupBrush" Color="#1E293B"/>
            <SolidColorBrush x:Key="BgButtonBrush" Color="#1E293B"/>
            <SolidColorBrush x:Key="BgButtonHoverBrush" Color="#334155"/>
            <SolidColorBrush x:Key="BgOverlayBrush" Color="#D21E293B"/>
            <SolidColorBrush x:Key="BgSplitterBrush" Color="#1E293B"/>

            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#334155"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#475569"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#CBD5E1"/>

            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#2DB8F5"/>
            <SolidColorBrush x:Key="AccentBlueBrush" Color="#2DB8F5"/>
            <SolidColorBrush x:Key="AccentButtonBgBrush" Color="#1287BE"/>
            <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#1A9BD8"/>
            <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#0E6C98"/>
            <SolidColorBrush x:Key="AccentSoftBgBrush" Color="#302DB8F5"/>
            <SolidColorBrush x:Key="AccentGoldBrush" Color="#FBBF24"/>
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#34D399"/>

            <!-- 通用按鈕樣式 (支援動態深淺色、主題色與視窗樣式圓角) -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource BgButtonBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ButtonCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="{DynamicResource BgButtonHoverBrush}"/>
                                    <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="{DynamicResource AccentButtonBgBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 主題強調按鈕樣式 (用於開啟 MusicXML、播放等主動作按鈕) -->
            <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource AccentButtonBgBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                <Setter Property="Padding" Value="18,7"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ButtonCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="{DynamicResource AccentButtonHoverBrush}"/>
                                    <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="{DynamicResource AccentButtonPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
