<Window x:Class="WinMusicXmlPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinMusicXmlPlayer.Controls"
        Title="Windows MusicXML 真實音源播放器 (繁體中文版)"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1160" Height="680"
        MinWidth="880" MinHeight="500"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">

    <Window.Resources>
        <!-- 系統選單分隔線樣式 -->
        <Style x:Key="SystemMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 系統選單項目樣式 (支援點擊自動展開、快捷鍵顯示與動態主題) -->
        <Style x:Key="SystemMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Border x:Name="Border"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,4"
                                    Margin="2,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="1"
                                               Text="▸"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Border}"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource BgPopupBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="0,2,8,8">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Border" Property="Padding" Value="10,3"/>
                                <Setter TargetName="Border" Property="Margin" Value="1,0"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="Border" Property="Padding" Value="14,6"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Border" Property="Padding" Value="14,6"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentSoftBgBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentSoftBgBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 靜音 (Mute) ToggleButton 樣式 -->
        <Style x:Key="MuteToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource BgButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#DC2626"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#F87171"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 獨奏 (Solo) ToggleButton 樣式 -->
        <Style x:Key="SoloToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource BgButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#D97706"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#FBBF24"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 0. 介面最上方系統選單 ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgMenuBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,2">
            <Menu x:Name="MainSystemMenu"
                  IsMainMenu="True"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}">
                <MenuItem x:Name="MenuFile"
                          Header="檔案(_F)"
                          Style="{StaticResource SystemMenuItemStyle}"
                          PreviewMouseLeftButtonDown="TopMenuItem_PreviewMouseLeftButtonDown"
                          MouseEnter="TopMenuItem_MouseEnter">
                    <MenuItem Header="開啟 MusicXML (Ctrl+O)"
                              Style="{StaticResource SystemMenuItemStyle}"
                              Click="BtnOpenFile_Click"/>
                    <MenuItem x:Name="MenuRecentFiles"
                              Header="最近開啟的樂譜"
                              Style="{StaticResource SystemMenuItemStyle}"/>
                    <MenuItem Header="跳轉至指定小節 (Ctrl+G)"
                              Style="{StaticResource SystemMenuItemStyle}"
                              Click="MenuGotoMeasure_Click"/>
                    <MenuItem Header="匯出 WAV 音訊檔 (Ctrl+E)"
                              Style="{StaticResource SystemMenuItemStyle}"
                              Click="MenuExportWav_Click"/>
                    <Separator Style="{StaticResource SystemMenuSeparatorStyle}"/>
                    <MenuItem Header="離開 (Ctrl+Q)"
                              Style="{StaticResource SystemMenuItemStyle}"
                              Click="MenuExit_Click"/>
                </MenuItem>

                <MenuItem x:Name="MenuSettings"
                          Header="設定(_S)"
                          Style="{StaticResource SystemMenuItemStyle}"
                          PreviewMouseLeftButtonDown="TopMenuItem_PreviewMouseLeftButtonDown"
                          MouseEnter="TopMenuItem_MouseEnter">
                    <MenuItem Header="音源設定 (Ctrl+M)"
                              Style="{StaticResource SystemMenuItemStyle}"
                              Click="MenuSoundFontSettings_Click"/>
                    <Separator Style="{StaticResource SystemMenuSeparatorStyle}"/>
                    <MenuItem Header="偏好設定 (Ctrl+P)"
                              Style="{StaticResource SystemMenuItemStyle}"
                              Click="MenuPreferences_Click"/>
                </MenuItem>

                <MenuItem x:Name="MenuHelp"
                          Header="說明(_H)"
                          Style="{StaticResource SystemMenuItemStyle}"
                          PreviewMouseLeftButtonDown="TopMenuItem_PreviewMouseLeftButtonDown"
                          MouseEnter="TopMenuItem_MouseEnter">
                    <MenuItem Header="關於 (F1)"
                              Style="{StaticResource SystemMenuItemStyle}"
                              Click="MenuAbout_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- ==================== 1. 頂部工具列 ==================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左側：開啟 MusicXML 與反覆記號開關 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenFile"
                            Style="{StaticResource PlayButtonStyle}"
                            Padding="14,6"
                            FontSize="13"
                            Content="開啟 MusicXML"
                            Click="BtnOpenFile_Click"
                            Margin="0,0,14,0"/>

                    <CheckBox x:Name="ChkExpandRepeats"
                              Content="啟用反覆記號 (Repeat)"
                              IsChecked="True"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"
                              FontSize="12.5"
                              Checked="ChkExpandRepeats_Changed"
                              Unchecked="ChkExpandRepeats_Changed"
                              ToolTip="勾選時自動展開樂譜中的 Repeat 與一二房反覆記號"
                              Cursor="Hand"/>
                </StackPanel>

                <!-- 中央：目前曲名標題 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="TxtScoreTitle"
                               Text="請選擇或開啟 MusicXML 樂譜"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtScoreSubtitle"
                               Text="支援真實樂器取樣協奏 · 鋼琴卷軸左右滑動調整時間"
                               FontSize="11"
                               Foreground="{DynamicResource AccentBlueBrush}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 右側：SF2 音源設定 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLoadSoundFont"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Padding="10,5"
                            FontSize="12"
                            Content="🔊 切換音源 (.sf2)"
                            Click="BtnLoadSoundFont_Click"
                            ToolTip="載入自訂 SoundFont 2 (.sf2) 真實樂器取樣音源檔"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. 中央主區域 (左側聲部面板 + 右側鋼琴卷軸與88鍵模擬琴鍵) ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="305" MinWidth="260" MaxWidth="440"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 2A. 左側：聲部顯示與獨立操作面板 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgSidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 聲部面板標題列 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            Padding="12,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="🎼 聲部顯示與混音控制"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtTrackSummary"
                                           Text="可針對不同聲部獨立靜音、獨奏、換樂器與調音量"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnResetTracks"
                                    Grid.Column="1"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="10,4"
                                    FontSize="11.5"
                                    Content="重置"
                                    Visibility="Collapsed"
                                    Click="BtnResetTracks_Click"
                                    VerticalAlignment="Center"
                                    ToolTip="重置全部聲部的靜音、獨奏、音量與樂器設定"/>
                        </Grid>
                    </Border>

                    <!-- 聲部清單 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl x:Name="TracksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCardBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            Margin="0,0,0,8"
                                            Padding="10,9">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 第一列：聲部色塊、名稱與靜音/獨奏按鈕 -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="14" Height="14"
                                                        CornerRadius="3"
                                                        Background="{Binding ThemeBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton Style="{StaticResource MuteToggleStyle}"
                                                                  Content="靜音 M"
                                                                  IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                                  Click="TrackMuteOrSolo_Click"
                                                                  Margin="0,0,5,0"
                                                                  ToolTip="靜音此聲部"/>
                                                    <ToggleButton Style="{StaticResource SoloToggleStyle}"
                                                                  Content="獨奏 S"
                                                                  IsChecked="{Binding IsSolo, Mode=TwoWay}"
                                                                  Click="TrackMuteOrSolo_Click"
                                                                  ToolTip="獨奏此聲部（僅播放標記獨奏之聲部）"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 第二列：GM 樂器音色切換選單 -->
                                            <Grid Grid.Row="1" Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="GM 音色："
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding InstrumentOptions}"
                                                          DisplayMemberPath="DisplayText"
                                                          SelectedValuePath="Program"
                                                          SelectedValue="{Binding GmProgram, Mode=TwoWay}"
                                                          SelectionChanged="TrackInstrument_SelectionChanged"
                                                          Height="26"
                                                          FontSize="12"
                                                          VerticalContentAlignment="Center"
                                                          ToolTip="此聲部的 GM 音色清單會依目前實際使用的音源（獨立鋼琴或通用音源）顯示 Preset 名稱；灰色項目表示該音源未提供，播放時會自動使用替代音色。">
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>
                                                </ComboBox>
                                            </Grid>

                                            <!-- 第三列：目前實際使用的音源 -->
                                            <Grid Grid.Row="2" Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="音源："
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11.5"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SoundFontRouteText}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SoundFontRouteText}"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UsesDedicatedPianoSynth}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlueBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- 第四列：聲部獨立音量滑桿與卷軸顯示開關 -->
                                            <Grid Grid.Row="3" Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="音量："
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"/>

                                                <Slider Grid.Column="1"
                                                        Minimum="0.0"
                                                        Maximum="1.5"
                                                        TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"
                                                        SmallChange="0.05"
                                                        LargeChange="0.05"
                                                        Value="{Binding Volume, Mode=TwoWay}"
                                                        ValueChanged="TrackVolume_ValueChanged"
                                                        MouseDoubleClick="TrackVolumeSlider_MouseDoubleClick"
                                                        ToolTip="以 5% 為單位調整（雙擊恢復 100%）"
                                                        VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding VolumePercentText}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11.5"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,8,0"/>

                                                <CheckBox Grid.Column="3"
                                                          Content="顯示卷軸"
                                                          IsChecked="{Binding IsVisibleOnRoll, Mode=TwoWay}"
                                                          Checked="TrackVisibility_Changed"
                                                          Unchecked="TrackVisibility_Changed"
                                                          Foreground="{DynamicResource TextMutedBrush}"
                                                          FontSize="11.5"
                                                          VerticalAlignment="Center"
                                                          Cursor="Hand"/>
                                            </Grid>

                                            <!-- 第五列：即時發聲強度動態條與音符數 -->
                                            <Grid Grid.Row="4" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0"
                                                             Minimum="0.0"
                                                             Maximum="1.0"
                                                             Value="{Binding CurrentActivity, Mode=OneWay}"
                                                             Height="4"
                                                             Background="{DynamicResource BgBadgeBrush}"
                                                             Foreground="{Binding ThemeBrush}"
                                                             BorderThickness="0"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding NoteCount, StringFormat='音符: {0}'}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 左下角音源資訊欄 -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BgPrimaryBrush}"
                            Padding="10,7"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0">
                        <TextBlock x:Name="TxtSoundFontStatus"
                                   Text="目前音源：載入中..."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 可調整寬度的分隔線 -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BgSplitterBrush}"/>

            <!-- 2B. 右側：鋼琴卷軸介面 + 下方 88 鍵鋼琴模擬彈奏介面 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="116"/>
                </Grid.RowDefinitions>

                <!-- 上方：鋼琴卷軸介面 (支援滑鼠左滑/右滑調整播放時間) -->
                <Grid Grid.Row="0">
                    <controls:PianoRollControl x:Name="PianoRoll"
                                          ToolTip="音符區單擊播放/暫停；左右拖曳調整時間"/>

                    <!-- 右下角卷軸視野縮放快捷鈕 -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,14,12"
                            Background="{DynamicResource BgOverlayBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="7,1"
                                    Content="－"
                                    Click="BtnZoomIn_Click"
                                    ToolTip="放大卷軸視野"
                                    Margin="0,0,4,0"/>
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="7,1"
                                    Content="＋"
                                    Click="BtnZoomOut_Click"
                                    ToolTip="縮小卷軸視野"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="BtnToggleViewMode"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="7,1"
                                    Content="⇄"
                                    Click="BtnToggleViewMode_Click"
                                    ToolTip="切換水平時間軸卷軸與垂直下落瀑布流模式"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 下方：88 鍵鋼琴模擬彈奏介面 (純視覺模擬展示) -->
                <Border Grid.Row="1"
                        Background="#090D16"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <controls:PianoKeyboardControl x:Name="PianoKeyboard"/>
                </Border>
            </Grid>

            <!-- 浮動式 Toast 訊息 -->
            <Border x:Name="ToastBanner"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,22"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource AccentPrimaryBrush}"
                    BorderThickness="1.5"
                    CornerRadius="{DynamicResource ButtonCornerRadius}"
                    Padding="18,9"
                    Visibility="Collapsed"
                    Opacity="0"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✓"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlueBrush}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtToastMessage"
                               Text="全部聲部已重置"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 3. 底部播放控制與樂曲即時資訊列 ==================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一列：時間軸拉桿 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="68"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtCurrentTime"
                               Grid.Column="0"
                               Text="00:00.0"
                               FontFamily="Consolas"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlueBrush}"
                               VerticalAlignment="Center"/>

                    <Slider x:Name="SliderTimeline"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            IsMoveToPointEnabled="True"
                            PreviewMouseLeftButtonDown="SliderTimeline_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="SliderTimeline_PreviewMouseLeftButtonUp"
                            ValueChanged="SliderTimeline_ValueChanged"
                            VerticalAlignment="Center"
                            Margin="8,0"/>

                    <TextBlock x:Name="TxtTotalTime"
                               Grid.Column="2"
                               Text="00:00.0"
                               FontFamily="Consolas"
                               FontSize="13.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- 第二列：播放控制按鈕、小節/拍號/調號/BPM 狀態、播放速度倍率與主音量 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左側：播放/暫停/停止/快退/快進按鈕 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnStop"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="9,5"
                                FontSize="12"
                                Content="⏮ 停止"
                                Click="BtnStop_Click"
                                Margin="0,0,5,0"/>

                        <Button x:Name="BtnStepBack"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="9,5"
                                FontSize="12"
                                Content="⏪ -5s"
                                Click="BtnStepBack_Click"
                                Margin="0,0,5,0"/>

                        <Button x:Name="BtnPlayPause"
                                Style="{StaticResource PlayButtonStyle}"
                                Width="92"
                                Padding="10,5"
                                FontSize="13"
                                Content="▶ 播放"
                                Click="BtnPlayPause_Click"
                                Margin="0,0,5,0"/>

                        <Button x:Name="BtnStepForward"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="9,5"
                                FontSize="12"
                                Content="⏩ +5s"
                                Click="BtnStepForward_Click"
                                Margin="0,0,5,0"/>

                        <Button x:Name="BtnLoopAB"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="9,5"
                                FontSize="12"
                                Content="🔁 A-B 循環"
                                Click="BtnLoopAB_Click"
                                ToolTip="點擊依序設定 A 點 → B 點 → 清除循環（亦可在卷軸上按滑鼠右鍵設定）"/>
                    </StackPanel>

                    <!-- 中央：即時小節、拍號、調號與速度資訊 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgBadgeBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                Padding="8,4"
                                Margin="3,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="MeasureBadge_MouseLeftButtonDown"
                                ToolTip="點擊或按 Ctrl+G 輸入小節號直接跳轉">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMeasureStatus" Text="小節：1 / 1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtGotoMeasureInput"
                                         Width="54"
                                         FontSize="12"
                                         Padding="3,0"
                                         Margin="4,0,0,0"
                                         Visibility="Collapsed"
                                         Background="{DynamicResource BgCardBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource AccentBlueBrush}"
                                         BorderThickness="1"
                                         KeyDown="TxtGotoMeasureInput_KeyDown"
                                         LostFocus="TxtGotoMeasureInput_LostFocus"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BgBadgeBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{DynamicResource BadgeCornerRadius}" Padding="8,4" Margin="3,0">
                            <TextBlock x:Name="TxtTimeSigStatus" Text="拍號：4/4" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource BgBadgeBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{DynamicResource BadgeCornerRadius}" Padding="8,4" Margin="3,0">
                            <TextBlock x:Name="TxtKeySigStatus" Text="調號：C 大調" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource BgBadgeBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{DynamicResource BadgeCornerRadius}" Padding="8,4" Margin="3,0">
                            <TextBlock x:Name="TxtTempoStatus" Text="速度：120 BPM" FontSize="12" Foreground="{DynamicResource AccentGoldBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- 右側：播放速度倍率與主音量控制 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="倍速：" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <Slider x:Name="SliderSpeed"
                                Width="72"
                                Minimum="0.5"
                                Maximum="1.5"
                                Value="1.0"
                                TickFrequency="0.25"
                                ValueChanged="SliderSpeed_ValueChanged"
                                MouseDoubleClick="BtnResetSpeed_Click"
                                ToolTip="拖曳調整播放倍速（雙擊恢復 1.00x）"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSpeedValue"
                                   Text="1.00x"
                                   Width="36"
                                   Foreground="{DynamicResource AccentBlueBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="4,0,3,0"/>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Padding="5,2"
                                FontSize="11"
                                Content="1x"
                                Click="BtnResetSpeed_Click"
                                Margin="0,0,10,0"/>

                        <TextBlock x:Name="TxtMasterVolumeLabel"
                                   Text="🔊 主音量："
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,3,0"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="TxtMasterVolumeLabel_MouseLeftButtonDown"
                                   ToolTip="點擊切換靜音 (快捷鍵 M)"/>
                        <Slider x:Name="SliderMasterVolume"
                                Width="72"
                                Minimum="0.0"
                                Maximum="2.0"
                                Value="1.0"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                SmallChange="0.05"
                                LargeChange="0.05"
                                ValueChanged="SliderMasterVolume_ValueChanged"
                                MouseDoubleClick="SliderMasterVolume_MouseDoubleClick"
                                ToolTip="以 5% 為單位調整（雙擊恢復 100%，會記住上次音量）"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtMasterVolume"
                                   Text="100%"
                                   Width="36"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="3,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
