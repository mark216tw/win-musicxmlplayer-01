<Window x:Class="WinMusicXmlPlayer.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="偏好設定"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="520" Height="510"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- 單一 Hue 彩色滑桿 Thumb 樣式 -->
        <Style x:Key="HueSliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Width="20" Height="20"
                                     Fill="White"
                                     Stroke="#1E293B"
                                     StrokeThickness="2"/>
                            <Ellipse Width="10" Height="10"
                                     Fill="{DynamicResource AccentPrimaryBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 單一 Hue 彩色滑桿樣式 (0..360 度全彩漸層軌道) -->
        <Style x:Key="HueRainbowSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="360"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="24">
                            <Border Height="12"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#F23636" Offset="0.000"/>
                                        <GradientStop Color="#F29436" Offset="0.083"/>
                                        <GradientStop Color="#F2F236" Offset="0.167"/>
                                        <GradientStop Color="#36F236" Offset="0.333"/>
                                        <GradientStop Color="#36F2F2" Offset="0.500"/>
                                        <GradientStop Color="#3636F2" Offset="0.667"/>
                                        <GradientStop Color="#F236F2" Offset="0.833"/>
                                        <GradientStop Color="#F23636" Offset="1.000"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource HueSliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="⚙️ 偏好設定"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="變更顯示模式、視窗樣式主題或主題色彩後將立即套用至整個播放器介面"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 設定項目卡片區 -->
        <StackPanel Grid.Row="1">
            <!-- 1. 語言設定 -->
            <Border Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="語言 (Language)"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="介面顯示語系"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="CmbLanguage"
                              Grid.Column="1"
                              Width="150"
                              Height="30"
                              VerticalContentAlignment="Center"
                              FontSize="12.5"
                              SelectedIndex="0"
                              SelectionChanged="CmbLanguage_SelectionChanged">
                        <ComboBoxItem Content="繁體中文" Tag="zh-TW"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 2. 顯示模式 (系統 / 淺色 / 深色，預設為系統) -->
            <Border Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="顯示模式"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="切換系統預設、淺色或深色外觀"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnModeSystem"
                                Content="🖥 系統"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="11,5"
                                FontSize="12.5"
                                Margin="0,0,6,0"
                                Click="BtnModeSystem_Click"/>
                        <Button x:Name="BtnModeLight"
                                Content="☀️ 淺色"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="11,5"
                                FontSize="12.5"
                                Margin="0,0,6,0"
                                Click="BtnModeLight_Click"/>
                        <Button x:Name="BtnModeDark"
                                Content="🌙 深色"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="11,5"
                                FontSize="12.5"
                                Click="BtnModeDark_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. 視窗樣式主題 -->
            <Border Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="視窗樣式主題"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="切換視窗標題列、圓角弧度與面板表面風格"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="4">
                        <Button x:Name="BtnWinStyleModern"
                                Content="現代圓潤"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="8,6"
                                FontSize="12"
                                Margin="0,0,5,0"
                                Click="BtnWinStyleModern_Click"
                                ToolTip="標準現代圓角與石板藍灰層次外觀"/>
                        <Button x:Name="BtnWinStyleStudio"
                                Content="專業俐落"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="8,6"
                                FontSize="12"
                                Margin="2,0,3,0"
                                Click="BtnWinStyleStudio_Click"
                                ToolTip="音樂工作站 (DAW) 高對比俐落直角風格"/>
                        <Button x:Name="BtnWinStyleTinted"
                                Content="主題炫彩"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="8,6"
                                FontSize="12"
                                Margin="3,0,2,0"
                                Click="BtnWinStyleTinted_Click"
                                ToolTip="大圓角並將目前主題色彩融入視窗背景與邊框"/>
                        <Button x:Name="BtnWinStyleConcert"
                                Content="古典音樂廳"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="8,6"
                                FontSize="12"
                                Margin="5,0,0,0"
                                Click="BtnWinStyleConcert_Click"
                                ToolTip="溫潤黑檀木與羊皮紙古典音樂廳暖色調風格"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- 4. 主題色彩 (6個活潑預設圓形色塊 + 下方同列左邊圓形色塊與單一Hue彩色滑桿) -->
            <Border Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,12">
                <StackPanel>
                    <!-- 第一列：標題與目前色彩名稱 + 6 個小型圓形色塊選項 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="主題色彩"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtActiveColorLabel"
                                       Text="晴空蔚藍 (#2DB8F5)"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- 預設 6 個活潑輕鬆的主題色彩 (小型圓形色塊選項) -->
                        <StackPanel x:Name="PresetSwatchesPanel"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 分隔細線 -->
                    <Border Height="1"
                            Background="{DynamicResource BorderSubtleBrush}"
                            Opacity="0.6"
                            Margin="0,11,0,10"/>

                    <!-- 第二列：左邊小型圓形色塊 (呈現目前自訂色彩顏色) + 右邊單一 Hue 彩色滑桿 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>

                        <!-- 彩色滑桿同列左邊：小型圓形色塊呈現目前自訂色彩顏色 -->
                        <Border x:Name="CustomColorOuterRing"
                                Grid.Column="0"
                                Width="28" Height="28"
                                CornerRadius="14"
                                BorderBrush="{DynamicResource TextPrimaryBrush}"
                                BorderThickness="2"
                                Padding="2"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                ToolTip="目前自訂主題色彩">
                            <Ellipse x:Name="CustomColorSwatchEllipse"
                                     Fill="{DynamicResource AccentPrimaryBrush}"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="自訂 Hue："
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <!-- 單一 Hue 彩色滑桿介面 -->
                        <Slider x:Name="SliderHue"
                                Grid.Column="2"
                                Style="{StaticResource HueRainbowSliderStyle}"
                                ValueChanged="SliderHue_ValueChanged"
                                VerticalAlignment="Center"/>

                        <TextBlock x:Name="TxtHueDegree"
                                   Grid.Column="3"
                                   Text="199°"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 底部關閉按鈕 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="完成"
                    Style="{StaticResource PlayButtonStyle}"
                    Width="96"
                    Padding="12,6"
                    FontSize="13"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
