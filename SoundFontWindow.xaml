<Window x:Class="WinMusicXmlPlayer.SoundFontWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音源設定 (SoundFont 2 雙槽分流)"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 頂部標題與說明 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="🔊 雙槽音源分流設定"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="支援「鋼琴專用音源」與「通用樂器音源」雙引擎同步混音：鋼琴聲部自動路由至鋼琴音源，其餘樂器使用通用音源"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
                <TextBlock Text="註：每個聲部的「GM 音色」會依該聲部實際使用的音源顯示 Preset 名稱；鋼琴聲部若有獨立鋼琴音源，GM 001–006 會顯示該音源的 Preset。"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="📂 開啟音源資料夾"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Padding="10,5"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Click="BtnOpenSoundFontFolder_Click"
                    ToolTip="在檔案總管開啟 Assets\SoundFonts 資料夾，方便放入 .sf2 音源檔案"/>
        </Grid>

        <!-- 雙槽音源分流設定 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <!-- 槽位 1：🎹 鋼琴專用音源 -->
            <Border Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,12"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎹 鋼琴專用音源 (.sf2)"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="{DynamicResource AccentSoftBgBrush}"
                                    BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="負責鋼琴家族 (GM 001–006)"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource AccentBlueBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtPianoSfStatus"
                                   Text="目前狀態：未指定（自動使用下方通用音源內的鋼琴音色）"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentBlueBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="選擇鋼琴 .sf2..."
                                Style="{StaticResource PlayButtonStyle}"
                                Padding="11,5"
                                FontSize="12"
                                Margin="0,0,6,0"
                                Click="BtnSelectPianoSf_Click"/>
                        <Button x:Name="BtnClearPianoSf"
                                Content="停用獨立鋼琴"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="10,5"
                                FontSize="12"
                                Click="BtnClearPianoSf_Click"
                                ToolTip="停用獨立鋼琴音源，讓鋼琴聲部回歸使用通用音源"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 槽位 2：🎻 通用樂器音源 -->
            <Border Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎻 通用樂器音源 (.sf2)"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="{DynamicResource BgBadgeBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="負責弦樂 / 木管 / 銅管 / 其餘所有樂器"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtGeneralSfStatus"
                                   Text="目前狀態：TimGM6mb.sf2"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentGreenBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="選擇通用 .sf2..."
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="11,5"
                                FontSize="12"
                                Margin="0,0,6,0"
                                Click="BtnSelectGeneralSf_Click"/>
                        <Button Content="還原預設 TimGM6mb"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="10,5"
                                FontSize="12"
                                Click="BtnResetGeneralSf_Click"
                                ToolTip="還原為內建的 TimGM6mb.sf2 通用音源"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 底部狀態與關閉按鈕 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtActionFeedback"
                       Grid.Column="0"
                       Text="提示：也可直接將 .sf2 音源檔拖曳至主視窗快速載入"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="完成"
                    Style="{StaticResource PlayButtonStyle}"
                    Width="96"
                    Padding="12,6"
                    FontSize="13"
                    IsDefault="True"
                    IsCancel="True"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
